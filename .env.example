# Copy to .env and fill in. .env is git-ignored.
# On a cloud host (Railway etc.), set these as environment variables instead.
ANTHROPIC_API_KEY=sk-ant-...

# Your name, so birthday wishes meant for someone else aren't treated as yours.
MY_NAME=

# Your time zone, for quiet hours, the daily summary and "today".
TIMEZONE=Asia/Kolkata

# On a server: your WhatsApp number with country code, digits only (e.g. 919876543210).
# The agent then prints a pairing code to type into your phone instead of a QR code.
# PAIR_PHONE_NUMBER=

# People to never read or reply to, and close people you want to answer yourself.
# Comma-separated phone numbers or names as saved in your phone. (Locally you can
# also use ignore-contacts.txt and close-contacts.txt.)
# IGNORE_CONTACTS=+91 98765 43210, Boss
# CLOSE_CONTACTS=Mom, Dad

# Optional settings (defaults shown).
# CLAUDE_MODEL=opus            # starting model: opus, sonnet or haiku (switch later with "greeter model ...")
# OCCASIONS=                   # e.g. diwali,holi,birthday; empty = all festivals and birthdays
# MIN_DELAY_SECONDS=15
# MAX_DELAY_SECONDS=300
# QUIET_HOURS=23:00-08:00      # or "off"
# DAILY_REPLY_LIMIT=40         # 0 = no limit
# SUMMARY_TIME=21:30           # or "off"
# COOLDOWN_HOURS=12
# MAX_MESSAGE_AGE_HOURS=24
# REPLY_TO_UNKNOWN=0
# DRY_RUN=0

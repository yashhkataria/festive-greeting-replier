{
  "name": "festive-greeting-replier-agent",
  "version": "1.0.0",
  "description": "WhatsApp agent that replies to festival greetings and birthday wishes from your saved contacts, using Claude.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "start:awake": "node scripts/keep-running.js",
    "dry-run": "DRY_RUN=1 node --env-file-if-exists=.env src/index.js",
    "pause": "node --env-file-if-exists=.env scripts/control.js pause",
    "resume": "node --env-file-if-exists=.env scripts/control.js resume",
    "status": "node --env-file-if-exists=.env scripts/control.js status",
    "model": "node --env-file-if-exists=.env scripts/control.js model",
    "test": "node --test test/*.test.js",
    "try": "node --env-file-if-exists=.env scripts/try.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "engines": {
    "node": ">=22.9"
  }
}
